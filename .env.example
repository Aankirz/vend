# Stripe test-mode secret key (sk_test_...). Never a live key.
STRIPE_SECRET_KEY=
# Optional: Stripe profile id (profile_test_...) advertised as networkId in MPP challenges.
STRIPE_PROFILE_ID=
# Gateway dev server port (default 4242)
PORT=
# Optional: where tools.json and events.jsonl live (default ./data)
VEND_DATA_DIR=
