# Stripe test-mode secret key (sk_test_...). Never a live key.
STRIPE_SECRET_KEY=
# Optional: Stripe profile id (profile_test_...) advertised as networkId in MPP challenges.
STRIPE_PROFILE_ID=
# Server port (app default 8080; gateway dev runnable default 4242)
PORT=
# Optional: where tools.json and events.jsonl live (default ./data)
VEND_DATA_DIR=
# Packager (phase 2): Vercel AI Gateway key for the packaging agent's LLM
AI_GATEWAY_API_KEY=
# Optional: AI Gateway model id (default stealth/cat-jam)
VEND_MODEL=
# CreateOS Sandbox API key (from createos.sh/app/profile or Stripe Projects)
CREATEOS_SANDBOX_API_KEY=
# Optional: python used by the local runner to build its venv (default python3)
VEND_PYTHON=
# App server (phase 3)
# build runner: createos | local (default createos when CREATEOS_SANDBOX_API_KEY is set)
VEND_RUNNER=
# If set, POST /api/tools requires header x-vend-admin: <token>
VEND_ADMIN_TOKEN=
# Optional upstream URL of an already-running chart tool to register as "chart" at startup
VEND_SEED_TOOL_URL=
# Optional public origin used in buyer snippets (e.g. https://vend.example)
VEND_PUBLIC_URL=
# CreateOS app deploy credentials (written by `stripe projects env --pull`; used by the createos CLI)
CREATEOS_PROJECT_API_KEY=
CREATEOS_PROJECT_API_URL=
CREATEOS_PROJECT_CREDENTIALS=
CREATEOS_PROJECT_DASHBOARD_URL=
CREATEOS_PLAN_API_KEY=
CREATEOS_PLAN_API_URL=
CREATEOS_PLAN_CREDENTIALS=
CREATEOS_PLAN_DASHBOARD_URL=
